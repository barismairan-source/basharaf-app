<?xml version="1.0"?>
<ruleset name="Dadvar">
	<description>WordPress coding standards for the Dadvar theme and companion plugin.</description>
	<file>themes</file>
	<file>plugins</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress-Extra">
		<!-- Class files use short names (class-settings.php for Dadvar_Core_Settings); kept stable for upgrades. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<!-- Template-hierarchy file names must contain the post type slug (archive-dadvar_service.php). -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>themes/dadvar/(archive|single)-dadvar_service\.php</exclude-pattern>
	</rule>
	<!-- Trivial widget getters are documented by their @return tag only. -->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>plugins/dadvar-core/includes/elementor/widgets/*</exclude-pattern>
	</rule>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dadvar"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dadvar"/>
				<element value="dadvar-core"/>
				<element value="dadvar-child"/>
			</property>
		</properties>
	</rule>
</ruleset>
