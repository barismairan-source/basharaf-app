# /etc/basharaf/env — runtime settings for basharaf-app on the VPS (root:root 600; systemd reads it).
# Copy each value from the Liara panel (app basharaff → Environment variables). Never commit the filled file.
# Lines without a value are fine for features you do not use.

# ── database (Liara Postgres): use the PUBLIC connection string; the internal one only works inside Liara ──
DATABASE_URL=
DATABASE_SSL=
RECIPE_STUDIO_DATABASE_URL=
RECIPE_STUDIO_DATABASE_SSL=
RECIPE_STUDIO_SESSION_SECRET=

# ── auth ──
JWT_SECRET=
CUSTOMER_JWT_SECRET=

# ── public addresses (also needed at build time: copy the NEXT_PUBLIC_* lines into /etc/basharaf/build.env) ──
NEXT_PUBLIC_APP_URL=
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_NESHAN_API_KEY=

# ── storage ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SMS ──
SMS_PROVIDER=
KAVENEGAR_API_KEY=
MELIPAYAMAK_TOKEN=
MELIPAYAMAK_FROM=
MELIPAYAMAK_OTP_BODY_ID=
SMS_DRY_RUN=

# ── mail ──
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=
MAIL_REPLY_TO=

# ── web push / notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_PROCESSOR_SECRET=

# ── VPS only ──
# off while Liara is still live, so notifications and SMS are not sent twice; remove (or set "on") after the DNS switch
OUTBOX_SCHEDULER=off
